# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：免登录模式（1 / true / yes / on）
# 开启后服务端把所有请求都视为已验证：不弹登录框、不依赖浏览器 cookie，
# 适合电视/投影仪这类「输入密码很麻烦、还会丢 cookie」的设备。
# ⚠️ 开启等于公开站点：任何能访问到该域名的人都能使用（包括代理接口）。
#    只在自己可信的网络里，或愿意承担被刷流量的风险时再开。
# AUTO_LOGIN=1

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：镜像地址。不设置时用本仓库自己的 GHCR（ghcr.io/dudu11255/libretv:latest），
# 不是上游的 ghcr.io/librespark/libretv —— 本仓库多了「分类浏览」模块，用上游镜像会看不到。
# - 从源码构建镜像：docker compose up -d --build
# - 用 CI 构建好的镜像：docker compose -f docker-compose.server.yml pull，再 up -d
# - 需要固定版本：LIBRETV_IMAGE=ghcr.io/dudu11255/libretv:<版本>
# LIBRETV_IMAGE=
